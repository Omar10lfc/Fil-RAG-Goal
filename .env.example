GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxx

HF_HOME=C:/HuggingFaceCache
TRANSFORMERS_CACHE=C:/HuggingFaceCache

# CORS: same-origin by default (empty = no CORS headers). Set to a
# comma-separated list only when the frontend is served from another origin.
# (The old Gradio default on port 7860 is gone — the static frontend is
# served from this same FastAPI app.)
FILGOAL_ALLOWED_ORIGINS=
FILGOAL_RATE_LIMIT=20/minute

# Rate-limit keying: "1" (default) honours X-Forwarded-For, required behind
# the HF Space proxy where every client shares one socket IP. Set to "0" when
# the server is directly exposed — otherwise clients can spoof XFF to dodge
# limits.
FILGOAL_TRUST_PROXY=1

# Default Groq models. Override these to reproduce the old Llama baseline
# while Groq still serves it, or to compare future model migrations.
FILGOAL_MODEL_BIG=openai/gpt-oss-120b
FILGOAL_MODEL_SMALL=openai/gpt-oss-20b

# Production default: route every intent to the big model. The small default
# (openai/gpt-oss-20b) has a runaway-reasoning loop on Arabic RAG contexts
# that exhausts its token budget and returns empty completions; forcing big
# keeps production answers flowing. Unset (=0) for the normal two-tier
# cascade (extractive intents → small, reasoning → big).
FILGOAL_FORCE_BIG_MODEL=1

# Demo / quota-escape: route every query to the small model regardless of intent.
# Unset (or =0) for normal routing. Wins over FILGOAL_FORCE_BIG_MODEL when both set.
FILGOAL_FORCE_SMALL_MODEL=0

# Disk-cache size bound: .cache/llm/ is evicted oldest-by-mtime beyond this
# many entries, so unique-query traffic can't grow the directory forever.
FILGOAL_CACHE_MAX_ENTRIES=5000
