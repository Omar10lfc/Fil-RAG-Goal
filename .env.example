GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxx

HF_HOME=C:/HuggingFaceCache
TRANSFORMERS_CACHE=C:/HuggingFaceCache

FILGOAL_ALLOWED_ORIGINS=http://127.0.0.1:7860,http://localhost:7860
FILGOAL_RATE_LIMIT=20/minute

# Default Groq models. Override these to reproduce the old Llama baseline
# while Groq still serves it, or to compare future model migrations.
FILGOAL_MODEL_BIG=openai/gpt-oss-120b
FILGOAL_MODEL_SMALL=openai/gpt-oss-20b

# Demo / quota-escape: route every query to the small model regardless of intent.
# Unset (or =0) for normal two-tier cascade.
FILGOAL_FORCE_SMALL_MODEL=0
