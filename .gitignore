# Environment
.env
.env.*
!.env.example

# Python
__pycache__/
*.py[cod]
*.pyo
venv/
.venv/
*.egg-info/
dist/
build/

# Data — raw stays local-only (re-scraped daily, too large for git).
# Processed chunks + FAISS artifacts are tracked via Git LFS (see .gitattributes)
# so the daily refresh bot's commits actually land.
data/raw/articles.jsonl
data/raw/.scraped_ids
data/processed/stats.json
data/raw/articles.jsonl.pre-sort-bak
# NOTE: faiss_index/index.bin, faiss_index/metadata.jsonl and
# data/processed/chunks.jsonl are LFS-tracked — do NOT re-ignore them here.
# The global *.bin rule below is scoped so it never matches faiss_index/.

# HuggingFace model cache
C:/HuggingFaceCache/
*.safetensors
# Model weight binaries elsewhere (narrowed: faiss_index/index.bin is LFS, not this)
*.pt
*.pth
model*.bin

# Evaluation output: the canonical report IS tracked (single report home);
# per-run comparisons live alongside it (report-llama-baseline, report-gpt-oss).

# Disk-based LLM response cache (qa_engine/cache.py)
.cache/

# IDE
.vscode/
.idea/
*.code-workspace

# OS
.DS_Store
Thumbs.db
desktop.ini

# Logs
*.log

# Jupyter
.ipynb_checkpoints/
*.ipynb
# Hugging Face Spaces deployment artifacts (deployed separately)
app.py
SPACE_README.md
plan.txt
